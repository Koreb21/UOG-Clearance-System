# Copy values into your shell, Docker, or hosting provider. Never commit real secrets.
# Spring Boot reads these as environment variables (see application.yml).

# Database
MONGODB_URI=mongodb://localhost:27017/clearance_system

# HTTP
SERVER_PORT=8080

# Auth — use long random strings in production
JWT_SECRET=replace-with-64-plus-char-random-secret
JWT_EXPIRATION_MINUTES=120

# Bootstrap super admin (disable after creating real admins if desired)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin@123

# QR certificate signing
QR_SIGNING_SECRET=replace-with-long-random-secret

# Student profile / ID uploads
STUDENT_MEDIA_DIR=storage/student-media

# Chapa (sandbox or live — see DEPLOYMENT.md)
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_CALLBACK_TOKEN=
CHAPA_WEBHOOK_SECRET=
CHAPA_CALLBACK_URL=http://localhost:8080/api/v1/payments/chapa/callback
CHAPA_RETURN_URL=http://localhost:5173/payments/complete
CHAPA_CHECKOUT_BASE_URL=https://checkout.chapa.co/checkout/payment
CHAPA_INITIALIZE_URL=https://api.chapa.co/v1/transaction/initialize
CHAPA_VERIFY_URL=https://api.chapa.co/v1/transaction/verify

# Manual finance receipt signing
FINANCE_RECEIPT_SECRET=replace-with-long-random-secret
